# Environment
NODE_ENV=development
WEBSITE_URL=http://localhost:3000
APPLICATION_ID=

# Better Auth - Configuration
BETTER_AUTH_SECRET=

# Database (Supabase Postgres). Use the CONNECTION POOLER string from
# Supabase Dashboard > Connect (host aws-0-/aws-1-<region>.pooler.supabase.com, user postgres.<project-ref>).
# Do NOT use the "Direct connection" host (db.<ref>.supabase.co): it is IPv6-only and
# fails from Vercel and most home networks. Use port 6543 (transaction mode) on Vercel.
DATABASE_URL=

# Gateway Configuration
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# Payments and tracking
AUTUMN_SECRET_KEY=

# Email (Resend) — booking notifications and report sending
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NOTIFY_EMAIL=

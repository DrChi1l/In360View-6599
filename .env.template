# Environment
NODE_ENV=development
WEBSITE_URL=http://localhost:3000
APPLICATION_ID=

# Supabase Auth (sign-in). The publishable key is public by design. These two are also read
# by the server to verify logins. VITE_ values are baked in at BUILD time: set them in Vercel
# (Settings > Environment Variables) and redeploy after changing them.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Comma-separated emails that are administrators (Bookings inbox, all-accounts view).
ADMIN_EMAILS=

# Database (Supabase Postgres). Use the CONNECTION POOLER string from
# Supabase Dashboard > Connect (host aws-0-/aws-1-<region>.pooler.supabase.com, user postgres.<project-ref>).
# Do NOT use the "Direct connection" host (db.<ref>.supabase.co): it is IPv6-only and
# fails from Vercel and most home networks. Use port 6543 (transaction mode) on Vercel.
DATABASE_URL=

# Gateway Configuration
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# Payments and tracking
AUTUMN_SECRET_KEY=

# Email (Resend) — booking notifications and report sending
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NOTIFY_EMAIL=

# Photo and signature storage. For Supabase Storage (shared with the Flutter app): create an access key under
# Storage > S3 Connection, then:
#   S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
#   S3_REGION=<your project's region, e.g. eu-central-1>
#   S3_FORCE_PATH_STYLE=true
#   S3_BUCKET=inspection-media
S3_ENDPOINT=
S3_REGION=
S3_FORCE_PATH_STYLE=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
